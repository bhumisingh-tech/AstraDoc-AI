# For local backend use only. Do not commit your actual key.

# Optional: enables Gemini-generated answers grounded in retrieved document excerpts.
# Without it, the app runs in evidence-only mode (retrieval + excerpts/citations still work).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STREAMING=1

# Optional limits (defaults shown are suitable for small/demo deployments).
# In-memory sessions cannot safely hold GB-scale libraries on typical Render instances.
#MAX_UPLOAD_BYTES=26214400
#MAX_FILE_BYTES=26214400
#MAX_FILES=12
#MIN_RELEVANCE_SCORE=0.03
#MIN_BEST_SCORE=0.05
#APP_NAME=DocChat Constellation
